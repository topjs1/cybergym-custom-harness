# Never commit a real key. Inject it only into the Purple Agent process/container.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_TEMPERATURE=0.0
DEEPSEEK_MAX_OUTPUT_TOKENS=4096

HARNESS_TASK_TIMEOUT_SECONDS=1800
HARNESS_TOKEN_BUDGET=100000
HARNESS_MAX_ATTEMPTS=30
HARNESS_LLM_TIMEOUT_SECONDS=180
HARNESS_FEEDBACK_TIMEOUT_SECONDS=60
HARNESS_WORK_ROOT=/data/tasks
HARNESS_RESULTS_CSV=/data/results.csv
HARNESS_EVENTS_JSONL=/data/events.jsonl

# Safe default for AgentBeats containers. This deterministic byte builder does
# not execute model-supplied code. Set to docker only where a Docker-compatible
# sandbox daemon is intentionally available.
HARNESS_PYTHON_BACKEND=disabled
HARNESS_SANDBOX_IMAGE=python:3.13.9-slim-bookworm
HARNESS_SANDBOX_TIMEOUT_SECONDS=20

# DeepSeek price snapshot: 2026-10-12. Choose the tier that applied to the run.
DEEPSEEK_PRICING_TIER=off_peak

