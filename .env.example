# Never commit a real key. Inject it only into the Purple Agent process/container.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_TEMPERATURE=0.0
DEEPSEEK_MAX_OUTPUT_TOKENS=4096

HARNESS_TASK_TIMEOUT_SECONDS=1800
HARNESS_TOKEN_BUDGET=100000
HARNESS_MAX_ATTEMPTS=30
# Hard USD cap on estimated DeepSeek cost. The harness stops once reached. 0 disables.
HARNESS_MAX_COST_USD=0
HARNESS_LLM_TIMEOUT_SECONDS=180
HARNESS_FEEDBACK_TIMEOUT_SECONDS=60
HARNESS_WORK_ROOT=/data/tasks
HARNESS_RESULTS_CSV=/data/results.csv
HARNESS_EVENTS_JSONL=/data/events.jsonl

# Safe default for AgentBeats containers. This deterministic byte builder does
# not execute model-supplied code. Set to docker only where a Docker-compatible
# sandbox daemon is intentionally available.
HARNESS_PYTHON_BACKEND=disabled
HARNESS_SANDBOX_IMAGE=python:3.13.9-slim-bookworm
HARNESS_SANDBOX_TIMEOUT_SECONDS=20

# DeepSeek price snapshot: 2026-10-12. Choose the tier that applied to the run.
DEEPSEEK_PRICING_TIER=off_peak

# Dynamic analysis. Safe default is off. In AgentBeats the Purple container has
# no Docker socket; set sidecar and let the dynamic-sandbox sidecar (the only
# Purple-side container with the socket) run the isolated build/fuzz containers.
HARNESS_DYNAMIC_ANALYSIS=off
HARNESS_DYNAMIC_URL=http://dynamic-sandbox:9110
HARNESS_DYNAMIC_TIMEOUT_SECONDS=120
HARNESS_BUILD_TIMEOUT_SECONDS=900
HARNESS_FUZZ_SECONDS=60
HARNESS_FUZZ_ENGINE=libfuzzer
HARNESS_MAX_CRASHES=8
HARNESS_BUILDER_IMAGE=gcr.io/oss-fuzz-base/base-builder
HARNESS_RUNNER_IMAGE=gcr.io/oss-fuzz-base/base-runner
HARNESS_BUILD_COMMAND=bash build.sh
# Allow dependency egress only during the build step; keep off when the tree is
# self-contained. Logged and never exposed to the model.
HARNESS_BUILD_ALLOW_NETWORK=false
# Optional shared secret between Purple and the sidecar.
HARNESS_SIDECAR_TOKEN=
# Absolute HOST path behind the ./data bind mount. Required in sidecar mode so
# the daemon resolves ephemeral container mounts on the host.
# HARNESS_DYNAMIC_HOST_ROOT=/absolute/path/to/data

# Static triage always runs (deterministic, no tokens). The subagents and the
# near-miss mutator are opt-in so the baseline single-agent loop is reproducible.
HARNESS_RECON_SUBAGENT=false
HARNESS_REVIEWER_SUBAGENT=false
HARNESS_RECON_MAX_TURNS=6
HARNESS_SUBAGENT_OUTPUT_TOKENS=1024
HARNESS_REVIEWER_MAX_CALLS=2
HARNESS_STALL_THRESHOLD=3
# Deterministic near-miss byte mutations (zero tokens). 0 disables.
HARNESS_MUTATION_ATTEMPTS=0
# Resume a stalled model that stops calling tools before submitting.
HARNESS_RESUME_NUDGES=4
# 1 = single solver. 2 = ensemble (static source-first + dynamic/format track).
HARNESS_TRACKS=1

