{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      deepseek_api_key: { type: "string", secret: true },
      deepseek_model: { type: "string", default: "deepseek-flash" },
      // Performance-first defaults: generous budget shared across three ensemble tracks.
      // The token budget is the effective cap; the USD cap is a loose safety net.
      token_budget: { type: "string", default: "700000" },
      task_timeout_seconds: { type: "string", default: "1800" },
      max_attempts: { type: "string", default: "60" },
      max_output_tokens: { type: "string", default: "8192" },
      max_cost_usd: { type: "string", default: "5.0" },
      tracks: { type: "string", default: "3" },
      recon_subagent: { type: "string", default: "true" },
      reviewer_subagent: { type: "string", default: "true" },
      mutation_attempts: { type: "string", default: "8" },
      resume_nudges: { type: "string", default: "6" },
    },
    required: ["deepseek_api_key"],
    additionalProperties: false,
  },

  program: {
    image: "ghcr.io/topjs1/cybergym-custom-harness:latest",
    entrypoint: [
      "/app/.venv/bin/python", "-m", "cybergym_harness.server",
      "--host", "0.0.0.0", "--port", "9009"
    ],
    env: {
      DEEPSEEK_API_KEY: "${config.deepseek_api_key}",
      DEEPSEEK_MODEL: "${config.deepseek_model}",
      DEEPSEEK_THINKING: "enabled",
      DEEPSEEK_MAX_OUTPUT_TOKENS: "${config.max_output_tokens}",
      HARNESS_TOKEN_BUDGET: "${config.token_budget}",
      HARNESS_TASK_TIMEOUT_SECONDS: "${config.task_timeout_seconds}",
      HARNESS_MAX_ATTEMPTS: "${config.max_attempts}",
      HARNESS_MAX_COST_USD: "${config.max_cost_usd}",
      HARNESS_TRACKS: "${config.tracks}",
      HARNESS_RECON_SUBAGENT: "${config.recon_subagent}",
      HARNESS_REVIEWER_SUBAGENT: "${config.reviewer_subagent}",
      HARNESS_MUTATION_ATTEMPTS: "${config.mutation_attempts}",
      HARNESS_RESUME_NUDGES: "${config.resume_nudges}",
      // AgentBeats gives Purple no docker socket; use the remote test_vulnerable loop only.
      HARNESS_DYNAMIC_ANALYSIS: "off",
      HARNESS_PYTHON_BACKEND: "disabled",
      PYTHONUNBUFFERED: "1",
    },
    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  exports: {
    a2a: "a2a",
  },
}
